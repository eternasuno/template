{
  "name": "solid-surreal-starter",
  "version": "0.1.0",
  "private": true,
  "description": "SolidJS 2 SSR + embedded SurrealDB starter with Better Auth.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
