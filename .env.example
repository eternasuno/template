NODE_ENV=development

# Frontend
WEB_PORT=5173

# Backend
API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Embedded SurrealDB (SurrealKV)
# Defaults to an absolute path under apps/api/data, independent of the working
# directory. Override only with an absolute path or a managed endpoint;
# relative overrides resolve against the process working directory.
# SURREAL_ENDPOINT=surrealkv:///var/lib/app/data
SURREAL_NAMESPACE=app
SURREAL_DATABASE=app

# Better Auth
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5173
