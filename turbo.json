{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["apps/api/.env", "apps/web/.env", "tsconfig.json"],
  "globalEnv": [
    "NODE_ENV",
    "API_PORT",
    "WEB_PORT",
    "SURREAL_ENDPOINT",
    "SURREAL_NAMESPACE",
    "SURREAL_DATABASE",
    "BETTER_AUTH_URL"
  ],
  "globalPassThroughEnv": ["BETTER_AUTH_SECRET"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}
